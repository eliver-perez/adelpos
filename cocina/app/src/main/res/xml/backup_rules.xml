<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 a 11: nada de la aplicación va a la copia de seguridad (además de allowBackup="false"; ver
     AndroidManifest.xml). En Android 12+ rigen data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
