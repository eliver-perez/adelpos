root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[{*.rs,*.py,*.sh}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 y makensis leen bien los acentos solo con BOM (etapa 9E).
[{*.ps1,*.nsh}]
charset = utf-8-bom
