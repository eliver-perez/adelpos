root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[{*.rs,*.py,*.sh}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 y makensis leen bien los acentos solo con BOM (etapa 9E).
[{*.ps1,*.nsh}]
charset = utf-8-bom

# Etapa A1 (Android): Kotlin con el estilo oficial (4 espacios, 100 columnas, como ktfmt) y XML de Android con 4.
[{*.kt,*.kts}]
indent_size = 4
max_line_length = 100

[android/**.xml]
indent_size = 4

# Etapa L1 (licencias): copias exactas del servidor de licencias (contracts/licencias/ORIGEN.md). El editor no les
# agrega el salto de línea final (los .lic y .licreq no lo tienen) ni les quita espacios: cualquier cambio rompe su
# SHA-256.
[{contracts/licencias/v1/**,docs/licencias/CONTRATO_LICENCIAS_ADEL_POS.md,docs/licencias/INTEGRACION_ADEL_POS.md}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
