.DS_Store
.local/
.tools/
.cache/
bin/
backups/
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
*.log
.env
.env.*
!*.example

__pycache__/

*.pyc

desktop/src-tauri/permissions/autogenerated/

# Binario externo del servidor que genera scripts/build-windows.ps1 para el instalador de Windows (etapa 9E).
desktop/src-tauri/binaries/

# Etapa 9H («Datos reales»): respaldos del sistema anterior (también comprimidos, los archivos de datos y de registro
# de SQL Server y los respaldos del registro), paquetes de migración y cualquier carpeta de datos extraídos. Nunca se
# versionan; scripts/check-legacy-data.sh falla si alguno llega al índice.
*.bak
*.bak.gz
*.bak.zip
*.bak.7z
*.mdf
*.ldf
*.ndf
*.trn
*.adelmig
legacy-data/

# Etapa A1 (Android): compilaciones y cachés de Gradle, la ruta local del SDK y cualquier llave o propiedades de firma.
# Las llaves de firma viven fuera del repositorio (android/CLAUDE.md, «Firma»); estas reglas son la red de seguridad.
android/.gradle/
android/.kotlin/
android/.idea/
android/**/build/
android/local.properties
*.jks
*.keystore
*.p12
android/**/signing.properties
android/**/keystore.properties
